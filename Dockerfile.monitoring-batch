FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN groupadd --system app \
    && useradd --system --gid app --home-dir /app app

WORKDIR /app
COPY requirements-monitoring-batch.txt ./
RUN python -m pip install --no-cache-dir -r requirements-monitoring-batch.txt
COPY --chown=app:app etl_scripts ./etl_scripts

USER app
CMD ["python", "-m", "etl_scripts.src.model_monitoring", "compute", "--catch-up", "--include-retention"]
