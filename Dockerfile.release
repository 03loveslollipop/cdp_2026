FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN groupadd --system app \
    && useradd --system --gid app --home-dir /app app

WORKDIR /app
COPY requirements-release.txt ./
RUN python -m pip install --no-cache-dir -r requirements-release.txt
COPY --chown=app:app etl_scripts ./etl_scripts
COPY --chown=app:app dataset.csv ./dataset.csv

USER app
CMD ["python", "-m", "etl_scripts.src.database", "release"]
