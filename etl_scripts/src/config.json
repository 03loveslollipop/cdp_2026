{
  "project": "credit_payment_eda",
  "paths": {
    "_comment": "raw_data is the source extract supplied with the technical test, versioned alongside the code so the notebook is reproducible. Nothing in the pipeline can regenerate it.",
    "raw_data": "../../dataset.csv"
  },
  "read_csv": {
    "sep": ";",
    "encoding": "utf-8-sig",
    "decimal_comma_columns": ["puntaje"],
    "date_columns": ["fecha_prestamo"],
    "date_dayfirst": true
  },
  "schema": {
    "target": "Pago_atiempo",
    "id_like": [],
    "categorical_nominal": ["tipo_credito", "tipo_laboral"],
    "categorical_ordinal": ["tendencia_ingresos"],
    "counts_discrete": [
      "plazo_meses",
      "edad_cliente",
      "cant_creditosvigentes",
      "huella_consulta",
      "creditos_sectorFinanciero",
      "creditos_sectorCooperativo",
      "creditos_sectorReal"
    ],
    "monetary": [
      "capital_prestado",
      "salario_cliente",
      "total_otros_prestamos",
      "cuota_pactada",
      "saldo_mora",
      "saldo_total",
      "saldo_principal",
      "saldo_mora_codeudor",
      "promedio_ingresos_datacredito"
    ],
    "scores": ["puntaje", "puntaje_datacredito"]
  },
  "null_tokens": ["", " ", "NA", "N/A", "na", "null", "NULL", "None", "nan", "-", "?"],
  "sentinels": {
    "puntaje_datacredito": [0],
    "puntaje": [95.227787]
  },
  "validation_rules": {
    "edad_cliente": { "min": 18, "max": 90 },
    "puntaje_datacredito": { "min": 150, "max": 950 },
    "puntaje": { "min": 0, "max": 100 },
    "salario_cliente": { "min": 1000000, "max": 100000000 },
    "capital_prestado": { "min": 100000, "max": 50000000 },
    "plazo_meses": { "min": 1, "max": 60 },
    "cuota_pactada": { "min": 10000, "max": 5000000 },
    "total_otros_prestamos": { "min": 0, "max": 500000000 },
    "cant_creditosvigentes": { "min": 0, "max": 40 },
    "huella_consulta": { "min": 0, "max": 30 }
  },
  "unit_scale": {
    "_comment": "Bureau balance columns arrive in thousands of COP while the loan and income columns are in COP. Proof: for the 402 clients with exactly one open obligation, capital_prestado / (saldo_total * 1000) has a median of 1.34, versus 1338 without the factor. Scaling here keeps every downstream ratio dimensionally correct.",
    "factor": 1000,
    "columns": ["saldo_total", "saldo_principal", "saldo_mora", "saldo_mora_codeudor"]
  },
  "column_semantics": {
    "_comment": "Meanings that are not obvious from the names and that change how a feature must be built.",
    "total_otros_prestamos": "monthly instalments on other loans, self-declared (76% of values are round multiples of 100,000 COP) - a payment, NOT an outstanding balance",
    "saldo_total": "total outstanding bureau balance across all obligations",
    "saldo_principal": "the principal part of saldo_total; the difference is accrued interest",
    "promedio_ingresos_datacredito": "bureau-estimated monthly income, in COP; runs about 55% of the declared salary",
    "huella_consulta": "count of credit-bureau inquiries over the trailing 6 months",
    "puntaje": "0-100 internal score, post-outcome - see leakage_columns",
    "puntaje_datacredito": "DataCredito Experian bureau score, 150-950 scale",
    "tipo_credito": "internal product or channel code, not the Superfinanciera modality classification"
  },
  "drop_columns": ["saldo_mora_codeudor"],
  "leakage_columns": ["puntaje"],
  "valid_labels": {
    "tendencia_ingresos": ["Decreciente", "Estable", "Creciente"],
    "tipo_laboral": ["Empleado", "Independiente"]
  },
  "predictive_pipeline": {
    "schema_version": "1.1.0",
    "_comment": "Pre-approval prediction contract. Bureau and proposed loan fields are assumed to be available at decision time because the extract has no feature snapshot timestamps. Confirm that assumption before deployment.",
    "train_test_split": {
      "strategy": "chronological",
      "timestamp_column": "fecha_prestamo",
      "train_fraction": 0.70,
      "keep_timestamp_groups_together": true
    },
    "required_predictors": [
      "tipo_credito",
      "capital_prestado",
      "plazo_meses",
      "edad_cliente",
      "tipo_laboral",
      "salario_cliente",
      "total_otros_prestamos",
      "cuota_pactada",
      "puntaje_datacredito",
      "cant_creditosvigentes",
      "huella_consulta",
      "saldo_mora",
      "saldo_total",
      "saldo_principal",
      "creditos_sectorFinanciero",
      "creditos_sectorCooperativo",
      "creditos_sectorReal",
      "promedio_ingresos_datacredito",
      "tendencia_ingresos"
    ],
    "categorical_predictors": ["tipo_credito", "tipo_laboral", "tendencia_ingresos"],
    "metadata_columns": ["fecha_prestamo"],
    "known_excluded_columns": ["Pago_atiempo", "puntaje", "saldo_mora_codeudor"],
    "drop_after_derivation": ["saldo_principal"],
    "hard_validation": {
      "ranges": {
        "edad_cliente": { "min": 18, "max": 90 },
        "puntaje_datacredito": { "min": 150, "max": 950 }
      },
      "positive": ["tipo_credito", "capital_prestado", "plazo_meses", "cuota_pactada"],
      "non_negative": [
        "salario_cliente",
        "total_otros_prestamos",
        "saldo_mora",
        "saldo_total",
        "saldo_principal",
        "cant_creditosvigentes",
        "huella_consulta",
        "creditos_sectorFinanciero",
        "creditos_sectorCooperativo",
        "creditos_sectorReal",
        "promedio_ingresos_datacredito"
      ],
      "integer": [
        "tipo_credito",
        "plazo_meses",
        "edad_cliente",
        "cant_creditosvigentes",
        "huella_consulta",
        "creditos_sectorFinanciero",
        "creditos_sectorCooperativo",
        "creditos_sectorReal"
      ]
    },
    "soft_validation_rules": {
      "salario_cliente": { "min": 1000000, "max": 100000000 },
      "capital_prestado": { "max": 50000000 },
      "plazo_meses": { "max": 60 },
      "cuota_pactada": { "max": 5000000 },
      "total_otros_prestamos": { "max": 500000000 },
      "cant_creditosvigentes": { "max": 40 },
      "huella_consulta": { "max": 30 }
    },
    "imputation": {
      "numeric_strategy": "median",
      "categorical_fill_value": "Missing",
      "all_missing_numeric_fallback": 0.0,
      "missing_indicator_prefix": "missing__"
    }
  },
  "eda": {
    "correlation_methods": ["pearson", "spearman"],
    "top_pairs": 25,
    "random_state": 42
  },
  "domain_reference": {
    "_comment": "Colombian market values behind the validation rules above. Each was verified against a published source; the citations live with the analysis write-up that accompanies this repository, not inside it. Values are recorded here so the pipeline carries its own reference data.",
    "bureau": "DataCredito Experian",
    "bureau_score_range": [150, 950],
    "bureau_score_ignores_inquiries": true,
    "inquiry_footprint_months": 6,
    "bureau_sectors_reported": ["financiero", "cooperativo", "real"],
    "bureau_sectors_missing_from_extract": ["telecomunicaciones", "fintech"],
    "smmlv_by_year": { "2024": 1300000, "2025": 1423500, "2026": 1750905 },
    "usura_ea_consumo_ordinario": 0.2966,
    "usura_ea_consumo_bajo_monto": 0.6885,
    "bajo_monto_ceiling_smmlv": 8,
    "debt_service_bands": { "ideal_max": 0.30, "moderate_max": 0.40 },
    "labour_informality_rate_2025": 0.557,
    "adults_with_credit_history": 0.70,
    "share_of_bureau_population_with_2_or_fewer_obligations": 0.62
  }
}
