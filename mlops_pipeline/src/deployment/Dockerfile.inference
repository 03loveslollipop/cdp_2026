FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    CDP_BIND_HOST=0.0.0.0 \
    CDP_ARTIFACT_DIR=/app/deployment_artifacts

RUN apt-get update \
    && apt-get install --no-install-recommends -y libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system app \
    && useradd --system --gid app --home-dir /app app

WORKDIR /app
COPY mlops_pipeline/src/deployment/requirements-inference.txt ./requirements-inference.txt
COPY mlops_pipeline/src/deployment/install_model_runtime.py ./mlops_pipeline/src/deployment/install_model_runtime.py
COPY mlops_pipeline/src/deployment/deployment_model_config.json ./mlops_pipeline/src/deployment/deployment_model_config.json
RUN python -m pip install --no-cache-dir -r requirements-inference.txt \
    && python mlops_pipeline/src/deployment/install_model_runtime.py

COPY --chown=app:app mlops_pipeline ./mlops_pipeline
COPY --chown=app:app deployment_artifacts ./deployment_artifacts

USER app
CMD ["python", "-m", "mlops_pipeline.src.deployment.model_deploy", "serve"]
