FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    CDP_BIND_HOST=0.0.0.0

RUN groupadd --system app \
    && useradd --system --gid app --home-dir /app app

WORKDIR /app
COPY mlops_pipeline/src/deployment/requirements-monitoring-ui.txt ./requirements-monitoring-ui.txt
RUN python -m pip install --no-cache-dir -r requirements-monitoring-ui.txt
COPY --chown=app:app mlops_pipeline ./mlops_pipeline

USER app
CMD ["python", "-m", "mlops_pipeline.src.deployment.model_monitoring.visualization"]
