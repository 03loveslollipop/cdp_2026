FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN groupadd --system app \
    && useradd --system --gid app --home-dir /app app

WORKDIR /app
COPY mlops_pipeline/src/deployment/requirements-release.txt ./requirements-release.txt
RUN python -m pip install --no-cache-dir -r requirements-release.txt
COPY --chown=app:app mlops_pipeline ./mlops_pipeline
COPY --chown=app:app database.csv ./database.csv

USER app
CMD ["python", "-m", "mlops_pipeline.src.deployment.database", "release"]
